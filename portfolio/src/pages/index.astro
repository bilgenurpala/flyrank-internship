---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SystemFlow from "../components/SystemFlow.astro";
import AnimatedPortrait from "../components/AnimatedPortrait.astro";
---

<BaseLayout title="Bilgenur Pala — Backend AI Engineering" description="Portfolio of Bilgenur Pala, a Backend AI Engineering intern building grounded AI systems with real tools and data.">
  <section class="hero shell section-space">
    <div class="hero-content" data-reveal="hero">
      <p class="eyebrow">Backend AI Engineering Intern</p>
      <h1>I build AI agents that run real tools, test their own work, and know when to ask a human.</h1>
      <p class="hero-copy">Not chat wrappers — systems grounded in application data, explicit checks, and approval boundaries.</p>
      <div class="action-row">
        <a class="button button-primary" href="https://cal.com/bilge-pala/intro-call" target="_blank" rel="noreferrer">Book a conversation</a>
        <a class="button button-secondary" href="#selected-work">See the work</a>
      </div>
    </div>
    <div class="hero-visual" data-reveal="hero-visual">
      <AnimatedPortrait />
    </div>
  </section>

  <section class="system-feature shell" data-reveal>
    <div class="system-feature-copy">
      <p class="eyebrow">My design principle</p>
      <h2>From a real request to a checked outcome.</h2>
      <p>This is the control loop I design toward: ground the request, use a permitted tool, verify what changed, and stop for human approval when the system reaches its boundary.</p>
    </div>
    <SystemFlow />
  </section>

  <section class="proof-band" aria-label="Selected evidence" data-reveal>
    <div class="shell proof-grid">
      <p><strong>30 API requests</strong><span>PetAdopt Newman run with 51 assertions and 0 failures</span></p>
      <p><strong>8/10 development eval</strong><span>Local RAG result, reported with a separate 7/10 frozen blind eval</span></p>
      <p><strong>4 backend builds</strong><span>HTTP contracts, persistence, authentication, and containers</span></p>
    </div>
  </section>

  <section id="selected-work" class="shell section-space" data-reveal>
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Evidence before claims.</h2>
      </div>
      <a class="inline-link" href="/work">View all work <span aria-hidden="true">→</span></a>
    </div>
    <div class="featured-case" data-reveal>
      <div>
        <div class="card-meta">
          <p class="eyebrow">Lead case</p>
          <span class="status-chip">Built · 5/5 evals</span>
        </div>
        <h2>SafeBump</h2>
        <p>A guarded Python agent that upgrades one pinned dependency on an isolated branch, runs pytest and pip check, then keeps, rolls back, or asks for approval from explicit evidence.</p>
        <a class="inline-link" href="/work#safebump">See the tested decision loop <span aria-hidden="true">→</span></a>
      </div>
      <div class="decision-loop" aria-label="SafeBump tested decision loop">
        <span>Inspect</span><span>Upgrade</span><span>Verify</span><span>Decide</span><span>Ask</span>
      </div>
    </div>
    <div class="card-grid" data-reveal>
      <ProjectCard eyebrow="Grounded AI" title="PetAdopt" description="A FastAPI service where the model interprets the request and PostgreSQL determines which animals actually exist." href="/work#petadopt" />
      <ProjectCard eyebrow="Local RAG" title="Foundry Local RAG Assistant" description="A fully local retrieval assistant with both development and frozen blind evaluation results kept visible." href="/work#rag" />
      <ProjectCard eyebrow="Backend foundations" title="Four builds, one progression" description="A sequence from explicit HTTP contracts to persistence, verified JWTs, PostgreSQL, and Docker Compose." href="/work#backend-foundations" />
    </div>
  </section>

  <section class="shell closing-panel" data-reveal>
    <p class="eyebrow">How I work</p>
    <h2>AI is a collaborator, not a substitute for ownership.</h2>
    <p>I use it to pressure-test decisions and expose gaps. I keep the implementation, verification, and final claims accountable to evidence I can explain.</p>
    <a class="inline-link" href="/about">More about how I work <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
